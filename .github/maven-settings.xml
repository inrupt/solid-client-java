<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for publishing to Sonatype Central from CI.

  Maven 3.10+ binds server credentials to repository origins. The 'central' server id
  defaults to https://repo.maven.apache.org, so the Sonatype origin must be declared
  explicitly or the credentials are withheld and uploads fail with HTTP 401.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>central</id>
      <username>${env.MAVEN_REPO_USERNAME}</username>
      <password>${env.MAVEN_REPO_TOKEN}</password>
      <repositoryOrigins>
        <repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
      </repositoryOrigins>
    </server>
  </servers>
</settings>
